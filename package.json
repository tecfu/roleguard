{
  "name": "@tecfu/roleguard",
  "version": "0.2.0",
  "description": "A dependency-free RBAC library with conditional rules and explanatory decisions.",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE.txt"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test test/test.ts",
    "test:watch": "node --test --watch test/test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecfu/roleguard.git"
  },
  "keywords": ["rbac", "authorization", "access-control", "acl", "permissions"],
  "author": "tecfu",
  "license": "GPL-3.0-only",
  "bugs": { "url": "https://github.com/tecfu/roleguard/issues" },
  "homepage": "https://github.com/tecfu/roleguard#readme",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
